{
  "policy_version": 3,
  "reasoning": "high",
  "providers": {
    "nvidia": {
      "base_url": "https://integrate.api.nvidia.com/v1",
      "secret": "NVIDIA_API_KEY",
      "application_rpm_cap": 30,
      "max_parallel_requests": 1,
      "models": {
        "coding_fast": "nvidia/nemotron-3.5-lightning-30b-a3b",
        "coding_deep": "nvidia/nemotron-3-ultra-550b-a55b"
      },
      "request_defaults": {
        "temperature": 1,
        "top_p": 0.95,
        "enable_thinking": true
      },
      "lightning_reasoning_budget": 16384
    },
    "google": {
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "secrets": [
        "GEMINI_API_KEY_1",
        "GEMINI_API_KEY_2"
      ],
      "separate_project_pools": {
        "enabled": true,
        "requirement": "Only valid when the two API keys belong to separate Google Cloud projects, not merely two keys in one project.",
        "selection": "round_robin_for_new_requests",
        "on_429": "stop_current_request_without_key_retry"
      },
      "video_review": {
        "primary": "gemini-3.5-flash-lite",
        "fallback": "gemini-3.1-flash-lite",
        "thinking_level": "HIGH",
        "per_project_app_limits": {
          "rpm": 10,
          "per_model_rpd": 500,
          "total_rpd": 1000
        },
        "two_project_combined_app_ceiling": {
          "rpm": 20,
          "total_rpd": 2000
        }
      },
      "gemma4": {
        "reasoning_models": [
          "gemma-4-26b-a4b-it",
          "gemma-4-31b-it"
        ],
        "thinking_mode": "HIGH",
        "per_project_app_limits": {
          "rpm": 28,
          "total_rpd": 14000
        },
        "two_project_combined_app_ceiling": {
          "rpm": 56,
          "total_rpd": 28000
        }
      },
      "quota_policy": {
        "guard_window": "rolling_24h_local",
        "on_429": "STOP_AND_WAIT",
        "retry_on_other_project_after_429": false,
        "max_parallel_requests_per_project": 1
      }
    }
  },
  "routing": {
    "code_generation": "nvidia.coding_deep",
    "routine_code_changes": "nvidia.coding_fast",
    "bug_repair": "nvidia.coding_fast",
    "architecture_review": "nvidia.coding_deep",
    "video_review": "google.video_review.primary",
    "video_review_fallback": "google.video_review.fallback",
    "text_reasoning_fallback": "google.gemma4.reasoning_models"
  }
}
